+    /** Preserve compile-time diagnostics when a compiled file is actually loaded. */
+    protected function collectRuntimeParameterDiagnostics(string $file, array $ast): void
+    {
+        $visit = function (Node $node, string $class = '') use (&$visit, $file): void {
+            if ($node instanceof Node\Stmt\ClassLike) {
+                $class = isset($node->namespacedName) ? $node->namespacedName->toString()
+                    : ($node->name?->toString() ?? 'class@anonymous');
+            }
+            if ($node instanceof Node\Stmt\Function_ || $node instanceof Node\Stmt\ClassMethod
+                || $node instanceof Node\Expr\Closure || $node instanceof Node\Expr\ArrowFunction) {
+                $name = match (true) {
+                    $node instanceof Node\Stmt\ClassMethod => $class . '::' . $node->name->toString(),
+                    $node instanceof Node\Stmt\Function_ => $node->namespacedName->toString(),
+                    default => '{closure}',
+                };
+                foreach ($node->params as $param) {
+                    if ($this->getEffectiveParameterType($param) === $param->type) { continue; }
+                    $this->runtimeFileDiagnostics[$file][] = [
+                        'line' => $node->getStartLine(),
+                        'message' => $name . '(): Implicitly marking parameter $' . $param->var->name
+                            . ' as nullable is deprecated, the explicit nullable type must be used instead',
+                    ];
+                }
+            }
+            foreach ($node->getSubNodeNames() as $key) {
+                foreach (is_array($node->$key) ? $node->$key : [$node->$key] as $child) {
+                    if ($child instanceof Node) { $visit($child, $class); }
+                }
+            }
+        };
+        foreach ($ast as $node) { $visit($node); }
+    }
