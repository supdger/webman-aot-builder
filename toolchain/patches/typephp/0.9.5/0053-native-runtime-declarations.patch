+        $padding = str_repeat("\n", max(0, $expression->getStartLine() - $line));
+        $hash = substr(hash('sha256', $this->sourceIdentity . ':' . $line
+            . ($context === 'class' || $context === 'global' ? '' : ':' . $context)), 0, 24);
+        $prototype = $context === 'parameter'
+            ? $prefix . 'return function ($__typephp_value = ' . $padding . $text . ') {};'
+            : $prefix . 'const __typephp_check_' . $hash . ' = ' . $padding . $text . ';';
