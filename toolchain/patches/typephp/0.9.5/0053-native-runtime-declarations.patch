+static void typephp_register_native_override(zend_class_entry *ce, const char *method,
+    const char *filename, uint32_t line)
+{
+    auto *function = static_cast<zend_function *>(
+        zend_hash_str_find_ptr(&ce->function_table, method, strlen(method)));
+    if (!function || function->type != ZEND_INTERNAL_FUNCTION) { return; }
+    zend_string *name = zend_string_init("Override", sizeof("Override") - 1, false);
+    zend_attribute *attribute = zend_add_function_attribute(function, name, 0);
+    zend_string_release(name);
+    attribute->lineno = line;
+    typephp_native_override_sources[attribute] = {filename, line};
+}
+
+static void typephp_check_native_overrides(zend_class_entry *ce)
+{
+    if (ce->ce_flags & ZEND_ACC_TRAIT) { return; }
+    void *entry;
+    zend_string *method;
+    ZEND_HASH_FOREACH_STR_KEY_PTR(&ce->function_table, method, entry) {
+        auto *function = static_cast<zend_function *>(entry);
+        if (!method || function->type != ZEND_INTERNAL_FUNCTION || function->common.scope != ce) { continue; }
+        zend_attribute *attribute = zend_get_attribute_str(function->common.attributes,
+            "override", sizeof("override") - 1);
+        auto source = typephp_native_override_sources.find(attribute);
+        if (source == typephp_native_override_sources.end()) { continue; }
+        bool matched = function->common.prototype != nullptr;
+        if (!matched && (ce->ce_flags & ZEND_ACC_INTERFACE)) {
+            for (uint32_t index = 0; index < ce->num_interfaces; index++) {
+                auto *parent = static_cast<zend_function *>(
+                    zend_hash_find_ptr(&ce->interfaces[index]->function_table, method));
+                if (parent && !(parent->common.fn_flags & ZEND_ACC_PRIVATE)) { matched = true; break; }
+            }
+        }
+        if (!matched) {
+            zend_string *filename = zend_string_init(source->second.filename,
+                strlen(source->second.filename), false);
+            zend_error_at_noreturn(E_COMPILE_ERROR, filename, source->second.line,
+                "%s::%s() has #[\\Override] attribute, but no matching parent method exists",
+                ZSTR_VAL(ce->name), ZSTR_VAL(function->common.function_name));
+        }
+    } ZEND_HASH_FOREACH_END();
+}
+
+void typephp_native_execution_shutdown() {
+    // Called after Zend deactivates its executor and closes suspended Fibers,
+    // before its request allocator is shut down. Bailout can skip destructors;
+    // their source metadata stays valid through executor teardown.
+    for (auto it = typephp_native_execution_states.rbegin(); it != typephp_native_execution_states.rend(); ++it) {
+        auto *state = *it;
+        zend_string_release(state->function.filename);
+        if (state->function.function_name) zend_string_release(state->function.function_name);
+        delete state;
+    }
+    typephp_native_execution_states.clear();
+    typephp_native_override_sources.clear();
+}
