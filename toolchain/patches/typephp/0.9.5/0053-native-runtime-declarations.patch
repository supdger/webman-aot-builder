+static zend_class_entry *typephp_create_unlinked_user_class(
+    const char *name, const zend_function_entry *methods, uint32_t flags,
+    const char *source, uint32_t line, size_t name_length)
+{
+    zend_string *public_name = zend_string_init(name, name_length, false);
+    zend_string *key = zend_string_tolower(public_name);
+    if (auto *old_ce = static_cast<zend_class_entry *>(zend_hash_find_ptr(EG(class_table), key))) {
+        zend_string *filename = zend_string_init(source, strlen(source), false);
+        if (old_ce->type == ZEND_INTERNAL_CLASS) {
+            zend_error_at_noreturn(E_ERROR, filename, line,
+                "Cannot redeclare %s %s", zend_get_object_type(old_ce), name);
+        }
+        zend_error_at_noreturn(E_ERROR, filename, line,
+            "Cannot redeclare %s %s (previously declared in %s:%d)",
+            zend_get_object_type(old_ce), name,
+            ZSTR_VAL(old_ce->info.user.filename), old_ce->info.user.line_start);
+    }
+    zend_string_release(key);
+    auto *ce = static_cast<zend_class_entry *>(zend_arena_alloc(&CG(arena), sizeof(zend_class_entry)));
+    memset(ce, 0, sizeof(*ce));
+    ce->type = ZEND_USER_CLASS;
+    ce->name = public_name;
+    zend_initialize_class_data(ce, true);
+    ce->ce_flags |= flags;
+    ce->info.user.filename = zend_string_init(source, strlen(source), false);
+    ce->info.user.line_start = line;
+    ce->info.user.line_end = line;
+    ce->default_object_handlers = &std_object_handlers;
+    if (methods != nullptr && methods[0].fname != nullptr
+        && zend_register_functions(ce, methods, &ce->function_table, MODULE_TEMPORARY) != SUCCESS) {
+        zval unlinked;
+        ZVAL_PTR(&unlinked, ce);
+        destroy_zend_class(&unlinked);
