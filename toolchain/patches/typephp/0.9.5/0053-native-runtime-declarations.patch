+<?php
+
+namespace TypePhp\Build;
+
+/** Successful output writes, separate from persistent compiler inputs and logs. */
+final class GeneratedArtifactReceipt
+{
+    public const array ROLES = [
+        'cpp-source', 'assembly-source', 'declaration-header', 'declaration-stub',
+        'generation-manifest', 'ast-cache', 'prepared-cache', 'stable-id-cache',
+        'incremental-state', 'object', 'object-cache', 'pch-header', 'pch',
+        'pch-cache', 'executable', 'link-cache',
+    ];
+
+    private mixed $stream = null;
+    private bool $failed = false;
+    private array $externalOutputs = [];
+
+    public function __construct(
+        private readonly string $path,
+        private readonly string $buildDirectory,
+        private readonly string $id = '',
+    ) {
+        if (str_starts_with($path, rtrim($buildDirectory, '/\\') . DIRECTORY_SEPARATOR)) {
+            $this->failure('The artifact receipt must be outside the build directory');
+            return;
+        }
+        $this->stream = @fopen($path, 'xb');
+        if (!is_resource($this->stream)) {
+            $this->failure('Cannot create exclusive artifact receipt: ' . $path);
+        }
+    }
+
+    public function allowFinalOutput(string $path): void
+    {
+        $this->externalOutputs[$path] = true;
+    }
+
+    /** @param array{command?: string, exit?: int, dependencies?: array} $native */
+    public function record(string $path, string $role, ?string $origin, string $factory, array $native = []): void
+    {
+        if ($this->failed) { return; }
+        try {
+            if (!in_array($role, self::ROLES, true)) {
+                throw new \RuntimeException('Unknown artifact role: ' . $role);
+            }
+            $canonical = realpath($path);
+            $root = realpath($this->buildDirectory);
+            if ($canonical === false || $root === false || is_link($path)
+                || (!str_starts_with($canonical, $root . DIRECTORY_SEPARATOR)
+                    && !isset($this->externalOutputs[$path]))) {
+                throw new \RuntimeException('Artifact is outside its configured output: ' . $path);
+            }
+            $current = $path;
+            while ($current !== dirname($current)) {
+                if (is_link($current)) { throw new \RuntimeException('Linked artifact path: ' . $path); }
+                $current = dirname($current);
+            }
+            clearstatcache(true, $path);
+            $before = lstat($path);
+            if ($before === false || ($before['mode'] & 0170000) !== 0100000 || $before['nlink'] !== 1) {
+                throw new \RuntimeException('Artifact must be an exclusive regular file: ' . $path);
+            }
+            $digest = hash_file('sha256', $path);
+            clearstatcache(true, $path);
+            $after = lstat($path);
+            if ($digest === false || array_intersect_key($before, array_flip(['dev', 'ino', 'size', 'mtime', 'ctime', 'mode', 'nlink']))
+                !== array_intersect_key($after, array_flip(['dev', 'ino', 'size', 'mtime', 'ctime', 'mode', 'nlink']))) {
+                throw new \RuntimeException('Artifact changed while recording: ' . $path);
+            }
+            $row = [
+                'version' => 1, 'nonce' => $this->id, 'build_root' => $root, 'path' => $canonical, 'role' => $role,
+                'origin' => $origin, 'factory' => $factory, 'device' => $after['dev'],
+                'inode' => $after['ino'], 'size' => $after['size'], 'sha256' => $digest,
+                'mtime' => $after['mtime'], 'ctime' => $after['ctime'],
+                'mode' => $after['mode'], 'nlink' => $after['nlink'],
+                'command' => $native['command'] ?? null, 'exit' => $native['exit'] ?? 0,
+                'dependencies' => $native['dependencies'] ?? [],
+            ];
+            $line = json_encode($row, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
+            if (!flock($this->stream, LOCK_EX)) { throw new \RuntimeException('Cannot lock artifact receipt'); }
+            try {
+                if (fwrite($this->stream, $line) !== strlen($line) || !fflush($this->stream)) {
+                    throw new \RuntimeException('Cannot append artifact receipt');
+                }
+            } finally { flock($this->stream, LOCK_UN); }
+        } catch (\Throwable $exception) { $this->failure($exception->getMessage()); }
+    }
+
+    private function failure(string $message): void
+    {
+        $this->failed = true;
+        fwrite(STDERR, 'Artifact receipt failure: ' . $message . "\n");
+    }
+}
