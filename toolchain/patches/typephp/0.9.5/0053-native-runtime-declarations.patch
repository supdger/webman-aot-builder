+struct TypephpNativeClassLinkContext {
+    zend_class_entry *ce;
+    decltype(zend_error_cb) previous_callback;
+    TypephpNativeClassLinkContext *previous;
+};
+static thread_local TypephpNativeClassLinkContext *typephp_native_class_link_context = nullptr;
+static void typephp_native_class_link_error(int type, zend_string *filename, uint32_t line, zend_string *message)
+{
+    auto *context = typephp_native_class_link_context;
+    auto callback = context->previous_callback;
+    for (auto *parent = context->previous; callback == typephp_native_class_link_error && parent != nullptr; parent = parent->previous) {
+        callback = parent->previous_callback;
+    }
+    if (type == E_COMPILE_ERROR && line == 0) {
+        void *entry;
+        ZEND_HASH_FOREACH_PTR(&context->ce->function_table, entry) {
+            auto *function = static_cast<zend_function *>(entry);
+            if (function->type != ZEND_INTERNAL_FUNCTION || function->common.scope != context->ce) continue;
+            const char *source;
+            uint32_t source_line;
+            if (!typephp_get_source_method_location(function, &source, &source_line)) continue;
+            std::string declaration;
+            if (function->common.fn_flags & ZEND_ACC_RETURN_REFERENCE) declaration = "& ";
+            if (function->common.scope->ce_flags & ZEND_ACC_ANON_CLASS) {
+                declaration += ZSTR_VAL(function->common.scope->name);
+            } else {
+                declaration.append(ZSTR_VAL(function->common.scope->name), ZSTR_LEN(function->common.scope->name));
+            }
+            declaration += "::";
+            declaration.append(ZSTR_VAL(function->common.function_name), ZSTR_LEN(function->common.function_name));
+            declaration += "(";
+            std::string prefix = "Declaration of " + declaration;
+            std::string unresolved = "Could not check compatibility between " + declaration;
+            const bool matched = (ZSTR_LEN(message) >= prefix.size()
+                    && memcmp(ZSTR_VAL(message), prefix.data(), prefix.size()) == 0)
+                || (ZSTR_LEN(message) >= unresolved.size()
+                    && memcmp(ZSTR_VAL(message), unresolved.data(), unresolved.size()) == 0);
+            if (matched) {
+                zend_string *source_file = zend_string_init(source, strlen(source), false);
+                callback(type, source_file, source_line, message);
+                zend_string_release(source_file);
+                return;
+            }
+        } ZEND_HASH_FOREACH_END();
+    }
+    callback(type, filename, line, message);
+}
