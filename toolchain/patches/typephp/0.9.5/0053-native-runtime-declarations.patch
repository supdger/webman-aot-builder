+static zend_class_entry *typephp_link_user_class(zend_class_entry *ce)
+{
+    zend_string *key = zend_string_tolower(ce->name);
+    zend_string *parent_key = ce->parent_name ? zend_string_tolower(ce->parent_name) : nullptr;
+    if (zend_hash_add_ptr(EG(class_table), key, ce) == nullptr) {
+        zend_error(E_ERROR, "Cannot declare class %s, because the name is already in use", ZSTR_VAL(ce->name));
+        return nullptr;
+    }
+    TypephpNativeClassLinkContext context{ce, zend_error_cb, typephp_native_class_link_context};
+    typephp_native_class_link_context = &context;
+    zend_error_cb = typephp_native_class_link_error;
+    zend_class_entry *volatile linked = nullptr;
+    volatile bool bailed = false;
+    JMP_BUF *previous_bailout = EG(bailout);
+    try {
+        zend_try {
+            linked = zend_do_link_class(ce, parent_key, key);
+        } zend_catch {
+            bailed = true;
+        } zend_end_try();
+    } catch (...) {
+        EG(bailout) = previous_bailout;
+        zend_error_cb = context.previous_callback;
+        typephp_native_class_link_context = context.previous;
+        if (parent_key) zend_string_release(parent_key);
+        zend_string_release(key);
+        throw;
+    }
+    zend_error_cb = context.previous_callback;
+    typephp_native_class_link_context = context.previous;
+    if (bailed) {
+        if (parent_key) zend_string_release(parent_key);
+        zend_string_release(key);
+        zend_bailout();
+    }
+    if (linked == nullptr) {
+        // The request table owns the CE after insertion, including failed links.
+        zend_hash_del(EG(class_table), key);
+    } else {
+        typephp_check_native_overrides(linked);
+    }
+    if (parent_key) { zend_string_release(parent_key); }
+    zend_string_release(key);
+    php::throwErrorIfOccurred();
+    return linked;
+}
