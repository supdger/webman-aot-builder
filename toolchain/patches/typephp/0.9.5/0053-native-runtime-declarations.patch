+static zval *typephp_dynamic_variable_slot(const php::Array &scope, zend_string *name, bool create) {
+    zval *slot = zend_hash_find(scope.array(), name);
+    if (slot == nullptr && create) {
+        zval value;
+        ZVAL_NULL(&value);
+        slot = zend_hash_add_new(scope.array(), name, &value);
+    }
+    if (slot != nullptr) ZVAL_DEINDIRECT(slot);
+    return slot;
+}
+void typephp_fetch_dynamic_variable(php::Var &result, const php::Array &scope, const php::Var &name, int mode, uint32_t line) {
+    php::Str key = name.toString();
+    const bool is_this = zend_string_equals_literal(key.str(), "this");
+    if (is_this && mode == 2) {
+        zend_throw_error(nullptr, "Cannot re-assign $this");
+        php::throwErrorIfOccurred();
+    }
+    zval receiver;
+    zval *slot = is_this ? nullptr : typephp_dynamic_variable_slot(scope, key.str(), mode == 2);
+    if (is_this && mode == 0) {
+        zend_object *object = zend_get_this_object(EG(current_execute_data));
+        if (object != nullptr) { ZVAL_OBJ(&receiver, object); slot = &receiver; }
+    }
+    zval replacement;
+    if (slot == nullptr || Z_TYPE_P(slot) == IS_UNDEF) {
+        if (mode == 0 || mode == 4) { zend_error_at(E_WARNING, zend_get_executed_filename_ex(), line, "Undefined variable $%s", key.data()); php::throwErrorIfOccurred(); }
+        if (mode == 2) { ZVAL_NULL(slot); }
+        else if (mode == 3) { ZVAL_UNDEF(&replacement); }
+        else { ZVAL_NULL(&replacement); }
+    }
+    if (mode == 2 || ((mode == 3 || mode == 4) && slot != nullptr && Z_TYPE_P(slot) != IS_UNDEF)) {
+        if (!Z_ISREF_P(slot)) ZVAL_MAKE_REF(slot);
+        ZVAL_COPY(&replacement, slot);
+    } else if (slot != nullptr && Z_TYPE_P(slot) != IS_UNDEF) {
+        ZVAL_COPY_DEREF(&replacement, slot);
+    }
+    zval old;
+    ZVAL_COPY_VALUE(&old, result.ptr());
+    ZVAL_COPY_VALUE(result.ptr(), &replacement);
+    zval_ptr_dtor(&old);
