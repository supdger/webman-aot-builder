+    private function noteConstantExpression(
+        Node\Expr $expression,
+        int $line,
+        bool $allowDynamic,
+        string $context,
+        string $class,
+        string $namespace,
+        array $uses,
+        \PhpParser\PrettyPrinter\Standard $printer,
+    ): void
+    {
+        $error = $this->constantExpressionError($expression, false, $allowDynamic);
+        if ($error === null) {
+            return;
+        }
+        if (!$error['conditional']) {
+            $this->compileErrors[] = ['line' => $line, 'message' => $error['message']];
+            return;
+        }
+        $text = $printer->prettyPrintExpr($expression);
+        $start = $expression->getStartFilePos();
+        $end = $expression->getEndFilePos();
+        if ($this->sourceCode !== '' && $start >= 0 && $end >= $start) {
+            $text = substr($this->sourceCode, $start, $end - $start + 1);
