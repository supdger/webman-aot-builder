+    private function constantExpressionError(Node\Expr $expression, bool $conditional = false, bool $allowDynamic = false): ?array
+    {
+        if ($allowDynamic && $expression instanceof Node\Expr\New_) {
+            return $this->allowedNewConstantError($expression, $conditional);
