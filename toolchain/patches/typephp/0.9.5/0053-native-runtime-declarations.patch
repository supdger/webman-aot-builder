+/** Native declaration factories and compiled PHP file initializers. */
+trait RuntimeDeclarationsTrait
+{
+    protected bool $runtimeDeclarationsEnabled = false;
+    protected ?string $runtimeEntrySource = null;
+    protected array $runtimeFileVariables = [];
+    protected array $runtimeExplicitPhpSources = [];
+    /** @var array<string, array{name:string,native:string,source:string,line:int,parent:string}> */
+    protected array $runtimeDeclarations = [];
+    /** Derived native identity lookup; never persisted with the prepared AST. */
+    protected array $runtimeDeclarationNativeIndex = [];
+    /** @var array<string, list<string>> */
+    protected array $runtimeFileInitializers = [];
+    /** @var array<string, list<string>> Canonical input => selected source aliases. */
+    protected array $runtimeFileAliases = [];
+    protected array $runtimeParseErrors = [];
+    protected array $runtimeFileDiagnostics = [];
+    protected array $runtimeCompileErrors = [];
+    protected array $runtimeConstantCompileChecks = [];
+
+    protected function isPhpSourceFile(string $file): bool
+    {
+        return isset($this->runtimeExplicitPhpSources[realpath($file) ?: $file])
+            || \TypePhp\Build\FileScanner::isPhpFile($file)
+            || ($this->runtimeEntrySource !== null && (realpath($file) ?: $file) === $this->runtimeEntrySource);
+    }
+
+    protected function invalidateRuntimeDeclarationIndexes(): void
+    {
+        $this->runtimeDeclarationNativeIndex = [];
+        $this->invalidateRuntimeCallStorageMetadata();
+    }
+
+    public function runtimeDeclaration(string $nativeName): ?array
+    {
+        if ($this->runtimeDeclarationNativeIndex === [] && $this->runtimeDeclarations !== []) {
+            foreach ($this->runtimeDeclarations as $identity => $declaration) {
+                $this->runtimeDeclarationNativeIndex[strtolower($declaration['native'])] = $identity;
+            }
+        }
+        $identity = $this->runtimeDeclarationNativeIndex[strtolower($nativeName)] ?? null;
+        return $identity === null ? null : ($this->runtimeDeclarations[$identity] ?? null);
+    }
+
+    /** @param list<string> $files */
+    protected function discoverRuntimeDeclarations(array $files): void
+    {
+        $this->runtimeDeclarations = [];
+        $this->invalidateRuntimeDeclarationIndexes();
+        $this->runtimeFileInitializers = [];
+        $this->runtimeFileVariables = [];
+        $this->runtimeParseErrors = [];
+        $this->runtimeFileDiagnostics = [];
+        $this->runtimeCompileErrors = [];
+        $this->runtimeConstantCompileChecks = [];
+        $this->conditionalDeclarationAsts = [];
+        $this->unavailableDeclarations = [];
+        $this->unavailableDeclarationFiles = [];
