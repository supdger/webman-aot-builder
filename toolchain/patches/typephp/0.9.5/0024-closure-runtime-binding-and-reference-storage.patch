+php::Reference typephp_property_ref_scoped(const php::Variant &object,
+                                           const php::Variant &member,
+                                           zend_class_entry *scope) {
+    auto value = typephp_read_property_scoped(object, member, scope, php::AttrMode::Update);
+    if (value.isReference()) return php::Reference(value.const_ptr());
+    if (!value.isIndirect()) return {};
+    auto reference = value.toReference();
+    auto *obj = object.object();
+    auto *slot = value.direct_ptr();
+    if (slot >= obj->properties_table && slot < obj->properties_table + obj->ce->default_properties_count) {
+        auto *info = zend_get_property_info_for_slot(obj, slot);
+        if (info && ZEND_TYPE_IS_SET(info->type)) ZEND_REF_ADD_TYPE_SOURCE(reference.reference(), info);
+    }
+    return reference;
 }
+
+void typephp_unset_property_scoped(const php::Variant &object,
+                                    const php::Variant &member,
+                                    zend_class_entry *scope) {
+    if (UNEXPECTED(!object.isObject())) {
+        php::throwError("Attempt to unset property on %s", object.typeStr());
+        return;
+    }
+    auto name = member.toString();
+    php::FakeScopeGuard guard{scope};
+    object.object()->handlers->unset_property(object.object(), name.str(), nullptr);
+    php::throwErrorIfOccurred();
+}
