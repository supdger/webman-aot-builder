+    protected function collectFinallyGotoLabels(Node|array $node, array &$labels): void
+    {
+        if (is_array($node)) { foreach ($node as $child) { if ($child instanceof Node) { $this->collectFinallyGotoLabels($child, $labels); } } return; }
+        if ($node instanceof Node\FunctionLike || $node instanceof Node\Stmt\ClassLike || $node instanceof Node\Stmt\Finally_) { return; }
+        if ($node instanceof Node\Stmt\Label) { $labels[$node->name->name] = true; }
+        foreach ($node->getSubNodeNames() as $name) { $child = $node->$name; if ($child instanceof Node || is_array($child)) { $this->collectFinallyGotoLabels($child, $labels); } }
+    }
+
+    protected function routeFinallyGotos(array $nodes, array $labels, string $variable, string $entry, array &$targets): array
+    {
+        $result = [];
+        foreach ($nodes as $node) {
+            if ($node instanceof Node\Stmt\Goto_ && !isset($labels[$node->name->name])) {
+                $target = $node->name->name;
+                $targets[$target] ??= count($targets) + 1;
+                $result[] = new Node\Stmt\Expression(new Expr\Assign(new Variable($variable), new Node\Scalar\Int_($targets[$target])));
+                $goto = clone $node;
+                $goto->name = new Node\Identifier($entry);
+                $result[] = $goto;
+            } elseif ($node instanceof Node && !$node instanceof Node\FunctionLike && !$node instanceof Node\Stmt\ClassLike && !$node instanceof Node\Stmt\Finally_) {
+                $node = clone $node;
+                foreach ($node->getSubNodeNames() as $name) {
+                    $child = $node->$name;
+                    if (is_array($child)) { $node->$name = $this->routeFinallyGotos($child, $labels, $variable, $entry, $targets); }
+                    elseif ($child instanceof Node) { $node->$name = $this->routeFinallyGotos([$child], $labels, $variable, $entry, $targets)[0]; }
+                }
+                $result[] = $node;
+            } else { $result[] = $node; }
+        }
+        return $result;
+    }
