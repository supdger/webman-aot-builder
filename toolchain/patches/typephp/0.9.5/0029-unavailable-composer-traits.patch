+            unset($this->excluded[$file]);
+        }
+        $this->choicesResolved = true;
+        $result = [];
+        foreach ($this->asts as $file => $ast) {
+            $variables = [];
+            $result[$file] = isset($this->excluded[$file]) ? [] : $this->select($ast, $file, $variables, false);
+        }
+        $declarations = [];
+        foreach ($result as $file => $ast) {
+            if (isset($this->unresolvedLoaders[$file]) && !isset($this->included[$file])) { continue; }
