+    private function index(array $statements, string $file): void
+    {
+        foreach ($statements as $node) {
+            if ($node instanceof Node\Stmt\Namespace_) {
+                $this->index($node->stmts, $file);
+            } elseif ($node instanceof Node\Stmt\ClassLike && $node->name !== null) {
+                $this->types[strtolower($this->name($node))][] = [$node, $file];
+            } elseif ($node instanceof Node\Stmt\Const_) {
+                foreach ($node->consts as $constant) {
+                    $this->constants[$this->name($constant)][] = [$constant, $file];
+                }
+            } elseif ($node instanceof Node\Stmt\Function_) {
+                $this->functions[strtolower($this->name($node))] = true;
+            }
+        }
+    }
