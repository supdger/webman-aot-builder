+struct typephp_unavailable_class_entry { const char *name; const char *trait; const char *kind; };
+static const typephp_unavailable_class_entry typephp_unavailable_classes[] = {
+{$classes}
+};
+struct typephp_declaration_file_entry { const char *path; const char *trait; const char *kind; };
+static const typephp_declaration_file_entry typephp_declaration_files[] = {
+{$files}
+};
+static zend_op_array *(*typephp_previous_compile_file)(zend_file_handle *, int) = nullptr;
+ZEND_TLS zend_string *typephp_declaration_runtime_root = nullptr;
+ZEND_TLS bool typephp_declaration_request_active = false;
+
+static zend_op_array *typephp_guard_declaration_file(zend_file_handle *file, int type) {
+    if (!typephp_declaration_request_active) {
+        return typephp_previous_compile_file(file, type);
+    }
+    char expanded[MAXPATHLEN];
+    zend_string *resolved = file->filename ? zend_resolve_path(file->filename) : nullptr;
+    const char *path = resolved ? ZSTR_VAL(resolved)
+        : (file->filename ? expand_filepath(ZSTR_VAL(file->filename), expanded) : nullptr);
+    const char *relative = nullptr;
+    const char *root = ZSTR_VAL(typephp_declaration_runtime_root);
+    const size_t length = ZSTR_LEN(typephp_declaration_runtime_root);
+#ifdef PHP_WIN32
+    if (path && _strnicmp(path, root, length) == 0 && (path[length] == '/' || path[length] == '\\\\')) {
+#else
+    if (path && strncmp(path, root, length) == 0 && path[length] == '/') {
+#endif
+        relative = path + length + 1;
+    }
