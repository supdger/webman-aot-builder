+    private function name(Node $node): string
+    {
+        if ($node instanceof Node\Name) {
+            return ($node->getAttribute('resolvedName') ?? $node)->toString();
+        }
+        return isset($node->namespacedName) ? $node->namespacedName->toString() : $node->name->toString();
+    }
