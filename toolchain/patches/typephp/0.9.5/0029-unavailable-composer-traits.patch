+            foreach ((new NodeFinder())->findInstanceOf($ast, Node\Stmt\Function_::class) as $node) {
+                $this->functions[strtolower($this->name($node))] = true;
+            }
+            foreach ((new NodeFinder())->findInstanceOf($ast, Node\Stmt\ClassLike::class) as $node) {
+                if ($node->name !== null) { $this->conditionalTypes[strtolower($this->name($node))][] = [$node, $file]; }
+            }
+        }
+    }
