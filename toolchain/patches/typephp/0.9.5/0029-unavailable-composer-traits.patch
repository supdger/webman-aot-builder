+/** Resolve compile-time declaration branches without loading project PHP. */
+final class ConditionalDeclarationResolver
+{
+    private object $unknown;
+    private array $types = [];
+    private array $functions = [];
+    private array $constants = [];
+    private array $conditionalTypes = [];
+    private array $excluded = [];
+    private array $included = [];
+    /** @var array<string, true> Declaration files reached only by an unresolved loader. */
+    private array $unresolvedLoaders = [];
+    private bool $unresolved = false;
+    private bool $choicesResolved = false;
