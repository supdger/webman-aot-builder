+    private function persistentReferenceOwnerExtends(string $class, string $expected): bool
+    {
+        $class = ltrim($class, '\\');
+        $expected = ltrim($expected, '\\');
+        if ((!$this->hasClass($class) && !$this->hasInterface($class))
+            || (!$this->hasClass($expected) && !$this->hasInterface($expected))) { return false; }
+        $pending = [$class];
+        $seen = [];
+        while ($pending !== []) {
+            $owner = ltrim(array_pop($pending), '\\');
+            $key = strtolower($owner);
+            if (isset($seen[$key])) { continue; }
+            $seen[$key] = true;
+            if (strcasecmp($owner, $expected) === 0) { return true; }
+            if ($this->hasClass($owner)) {
+                $definition = $this->getClass($owner);
+                if ($definition->extends !== '') { $pending[] = $definition->extends; }
+                array_push($pending, ...$definition->implements);
+            } elseif ($this->hasInterface($owner)) {
+                $definition = $this->getInterface($owner);
+                array_push($pending, ...($definition->extendsList ?: ($definition->extends ? [$definition->extends] : [])));
+            }
+            // Native and unknown ancestors have no PHP declaration ABI to propagate.
+        }
+        return false;
+    }
