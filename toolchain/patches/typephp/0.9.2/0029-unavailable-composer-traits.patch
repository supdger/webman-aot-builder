+<?php
+
+namespace TypePhp\Build;
+
+use PhpParser\Node;
+use PhpParser\NodeFinder;
+use PhpParser\NodeTraverser;
+use PhpParser\NodeVisitor\NameResolver;
+
+/** Keep optional Composer declarations unavailable until PHP tries to load them. */
+trait UnavailableDeclarationsTrait
+{
+    /** @var array<string, array{name:string,file:string,trait:string,package:string}> */
+    protected array $unavailableDeclarations = [];
+    /** @var array<string, string> */
+    protected array $unavailableDeclarationFiles = [];
+    /** @var array<string, string> Composer metadata content identities. */
+    protected array $declarationAutoloadInputs = [];
+    /** @var list<string> */
+    protected array $declarationSourceFiles = [];
+
+    public function discoverUnavailableDeclarations(array $files): void
+    {
+        $graph = [];
+        $fileDeclarations = [];
+        $fileAsts = [];
+        $roots = [];
+        $this->unavailableDeclarations = [];
+        $this->unavailableDeclarationFiles = [];
+        $this->declarationAutoloadInputs = [];
+        $this->declarationSourceFiles = array_values(array_filter(
+            array_map(static fn(string $file): string => realpath($file) ?: $file, $files),
+            static fn(string $file): bool => str_ends_with(strtolower($file), '.php'),
+        ));
+        foreach ($this->declarationSourceFiles as $file) {
+            try {
+                $ast = $this->getAstCache()->load($file, (string) file_get_contents($file));
+                $traverser = new NodeTraverser();
+                $traverser->addVisitor(new NameResolver(null, ['replaceNodes' => false]));
+                $ast = $traverser->traverse($ast);
+            } catch (\PhpParser\Error) {
+                continue; // prepareFile owns parser diagnostics.
+            }
+            $fileAsts[$file] = $ast;
+            foreach ((new NodeFinder())->findInstanceOf($ast, Node\Stmt\ClassLike::class) as $node) {
+                if ($node->name === null) {
+                    continue;
+                }
+                $name = isset($node->namespacedName) ? $node->namespacedName->toString() : $node->name->toString();
+                $key = strtolower($name);
+                if (isset($graph[$key])) {
+                    throw new \RuntimeException("Duplicate declaration while resolving optional traits: {$name}");
+                }
+                $traits = [];
+                $dependencies = [];
+                foreach ($node->stmts as $statement) {
+                    if ($statement instanceof Node\Stmt\TraitUse) {
+                        foreach ($statement->traits as $trait) {
+                            $traits[] = $this->resolvedDeclarationName($trait);
+                        }
+                    }
+                }
+                if ($node instanceof Node\Stmt\Class_ && $node->extends !== null) {
+                    $dependencies[] = $this->resolvedDeclarationName($node->extends);
+                }
+                foreach ($node instanceof Node\Stmt\Interface_ ? $node->extends : ($node->implements ?? []) as $parent) {
+                    $dependencies[] = $this->resolvedDeclarationName($parent);
+                }
+                $graph[$key] = ['name' => $name, 'file' => $file, 'traits' => $traits,
+                    'dependencies' => $dependencies, 'isTrait' => $node instanceof Node\Stmt\Trait_];
+                $fileDeclarations[$file][] = $key;
+            }
+        }
+        foreach ($graph as $key => $declaration) {
+            $missing = [];
+            foreach ($declaration['traits'] as $trait) {
+                $traitKey = strtolower($trait);
+                if ((isset($graph[$traitKey]) && !$graph[$traitKey]['isTrait'])
+                    || ($this->hasClass($trait) && !$this->getClass($trait)->trait)
+                    || class_exists($trait, false) || interface_exists($trait, false)) {
+                    throw new \RuntimeException("{$declaration['name']} cannot use {$trait}: target is not a trait");
+                }
+                if (isset($graph[$traitKey]) || $this->hasClass($trait) || trait_exists($trait, false)) {
+                    continue;
+                }
+                $missing[] = $trait;
+            }
+            if ($missing !== []) {
+                $this->unavailableDeclarations[$key] = $declaration + ['trait' => $missing[0],
+                    'missingTraits' => $missing];
+                $roots[$key] = true;
+            }
+        }
+        do {
+            $changed = false;
+            foreach ($graph as $key => $declaration) {
+                if (isset($this->unavailableDeclarations[$key])) {
+                    continue;
+                }
+                foreach (array_merge($declaration['traits'], $declaration['dependencies']) as $dependency) {
+                    $root = $this->unavailableDeclarations[strtolower($dependency)] ?? null;
+                    if ($root !== null) {
+                        $this->unavailableDeclarations[$key] = $declaration + ['trait' => $root['trait'],
+                            'missingTraits' => $root['missingTraits']];
+                        $changed = true;
+                        break;
+                    }
+                }
+            }
+        } while ($changed);
+        foreach ($this->unavailableDeclarations as $key => $declaration) {
+            $file = $declaration['file'];
+            $package = $this->lazyDeclarationPackage($file, $declaration['name'], isset($roots[$key]),
+                $declaration['missingTraits']);
+            if ($package === null || count($fileDeclarations[$file] ?? []) !== 1
+                || !$this->isOnlyLazyDeclaration($fileAsts[$file])) {
+                throw new \RuntimeException("Cannot defer unavailable declaration {$declaration['name']}: "
+                    . "Trait \"{$declaration['trait']}\" not found; source is not a single Composer lazy declaration: {$file}");
+            }
+            $this->unavailableDeclarations[$key]['package'] = $package;
+            $this->unavailableDeclarationFiles[$file] = $declaration['trait'];
+        }
+        ksort($this->unavailableDeclarations, SORT_STRING);
+        ksort($this->unavailableDeclarationFiles, SORT_STRING);
+    }
+
+    private function resolvedDeclarationName(Node\Name $name): string
+    {
+        return ($name->getAttribute('resolvedName') ?? $name)->toString();
+    }
+
+    private function isOnlyLazyDeclaration(array $statements): bool
+    {
+        foreach ($statements as $statement) {
+            if ($statement instanceof Node\Stmt\Namespace_) {
+                if (!$this->isOnlyLazyDeclaration($statement->stmts)) {
+                    return false;
+                }
+            } elseif ($statement instanceof Node\Stmt\Declare_) {
+                if ($statement->stmts !== null) {
+                    return false;
+                }
+            } elseif (!$statement instanceof Node\Stmt\ClassLike
+                && !$statement instanceof Node\Stmt\Use_
+                && !$statement instanceof Node\Stmt\GroupUse
+                && !$statement instanceof Node\Stmt\Nop) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Resolve installed package identity without executing target autoload PHP. */
+    private function lazyDeclarationPackage(string $file, string $class, bool $root, array $missingTraits): ?string
+    {
+        $directory = dirname($file);
+        while ($directory !== dirname($directory)) {
+            $installedFile = $directory . '/vendor/composer/installed.json';
+            if (is_file($installedFile)) {
+                break;
+            }
+            $directory = dirname($directory);
+        }
+        if (!isset($installedFile) || !is_file($installedFile)) {
+            return null;
+        }
+        $installed = $this->readDeclarationManifest($installedFile);
+        $packages = $installed['packages'] ?? $installed;
+        $rootManifest = $this->readDeclarationManifest($directory . '/composer.json');
+        foreach ($missingTraits as $missingTrait) {
+            if ($this->hasUnselectedTraitProvider($directory, $rootManifest, $missingTrait)) {
+                return null;
+            }
+        }
+        $eagerFiles = [];
+        foreach ($rootManifest['autoload']['files'] ?? [] as $eager) {
+            $eagerFiles[] = realpath($directory . '/' . $eager);
+        }
+        $owner = null;
+        $installedNames = array_column($packages, 'name');
+        foreach ($packages as $package) {
+            if (!is_array($package) || !is_string($package['install-path'] ?? null)) {
+                continue;
+            }
+            $path = realpath(dirname($installedFile) . '/' . $package['install-path']);
+            if ($path === false) {
+                continue;
+            }
+            $manifest = $this->readDeclarationManifest($path . '/composer.json');
+            foreach (array_merge($manifest['autoload']['files'] ?? [], $package['autoload']['files'] ?? []) as $eager) {
+                $eagerFiles[] = realpath($path . '/' . $eager);
+            }
+            foreach ($missingTraits as $missingTrait) {
+                if ($this->hasUnselectedTraitProvider($path, $package, $missingTrait)
+                    || $this->hasUnselectedTraitProvider($path, $manifest, $missingTrait)) {
+                    return null;
+                }
+            }
+            foreach ($manifest['autoload']['psr-4'] ?? [] as $prefix => $paths) {
+                if (!str_starts_with($class, $prefix)) {
+                    continue;
+                }
+                foreach ((array) $paths as $sourcePath) {
+                    $expected = realpath($path . '/' . $sourcePath . '/'
+                        . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php');
+                    if ($expected === $file) {
+                        if (($manifest['name'] ?? null) !== ($package['name'] ?? null)
+                            || ($manifest['autoload']['psr-4'] ?? []) != ($package['autoload']['psr-4'] ?? [])) {
+                            return null;
+                        }
+                        foreach ($manifest['require'] ?? [] as $required => $_constraint) {
+                            if (str_contains($required, '/') && !in_array($required, $installedNames, true)) {
+                                return null;
+                            }
+                        }
+                        if ($root && array_filter(array_keys($manifest['suggest'] ?? []),
+                            static fn(string $suggested): bool => str_contains($suggested, '/')
+                                && !in_array($suggested, $installedNames, true)) === []) {
+                            return null;
+                        }
+                        $owner = $package['name'];
+                    }
+                }
+            }
+        }
+        return in_array($file, $eagerFiles, true) ? null : $owner;
+    }
+
+    private function hasUnselectedTraitProvider(string $path, array $manifest, string $trait): bool
+    {
+        foreach ($manifest['autoload']['psr-4'] ?? [] as $prefix => $paths) {
+            if (!str_starts_with($trait, $prefix)) {
+                continue;
+            }
+            foreach ((array) $paths as $sourcePath) {
+                if (is_file($path . '/' . $sourcePath . '/'
+                    . str_replace('\\', '/', substr($trait, strlen($prefix))) . '.php')) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private function readDeclarationManifest(string $path): array
+    {
+        if (!is_file($path)) {
+            throw new \RuntimeException("Missing Composer declaration metadata: {$path}");
+        }
+        $contents = (string) file_get_contents($path);
+        $this->declarationAutoloadInputs[$path] = hash('sha256', $contents);
+        $manifest = json_decode($contents, true, flags: JSON_THROW_ON_ERROR);
+        if (!is_array($manifest)) {
+            throw new \RuntimeException("Invalid Composer declaration metadata: {$path}");
+        }
+        return $manifest;
+    }
+}
