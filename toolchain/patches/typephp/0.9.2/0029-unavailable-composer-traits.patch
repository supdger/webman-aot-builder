+<?php
+
+namespace TypePhp\Generator;
+
+/** Zend loading must still fail when an optional declaration cannot be composed. */
+final class UnavailableDeclarationGenerator
+{
+    public function render(string $loader, array $declarations): string
+    {
+        $classEntries = [];
+        $fileEntries = [];
+        foreach ($declarations as $declaration) {
+            $classEntries[] = '{' . $this->literal($declaration['name']) . ', '
+                . $this->literal($declaration['trait']) . '}';
+            $fileEntries[$declaration['file']] = $declaration['trait'];
+        }
+        ksort($fileEntries, SORT_STRING);
+        $paths = [];
+        foreach ($fileEntries as $file => $trait) {
+            $paths[] = '{' . $this->literal($file) . ', ' . $this->literal($trait) . '}';
+        }
+        $classes = implode(",\n", $classEntries);
+        $files = implode(",\n", $paths);
+        return <<<CPP
+struct typephp_unavailable_class_entry { const char *name; const char *trait; };
+static const typephp_unavailable_class_entry typephp_unavailable_classes[] = {
+{$classes}
+};
+struct typephp_declaration_file_entry { const char *path; const char *trait; };
+static const typephp_declaration_file_entry typephp_declaration_files[] = {
+{$files}
+};
+static zend_op_array *(*typephp_previous_compile_file)(zend_file_handle *, int) = nullptr;
+ZEND_TLS zend_string *typephp_declaration_runtime_root = nullptr;
+ZEND_TLS bool typephp_declaration_request_active = false;
+
+static zend_op_array *typephp_guard_declaration_file(zend_file_handle *file, int type) {
+    if (!typephp_declaration_request_active) {
+        return typephp_previous_compile_file(file, type);
+    }
+    char expanded[MAXPATHLEN];
+    zend_string *resolved = file->filename ? zend_resolve_path(file->filename) : nullptr;
+    const char *path = resolved ? ZSTR_VAL(resolved)
+        : (file->filename ? expand_filepath(ZSTR_VAL(file->filename), expanded) : nullptr);
+    const char *relative = nullptr;
+    const char *root = ZSTR_VAL(typephp_declaration_runtime_root);
+    const size_t length = ZSTR_LEN(typephp_declaration_runtime_root);
+#ifdef PHP_WIN32
+    if (path && _strnicmp(path, root, length) == 0 && (path[length] == '/' || path[length] == '\\\\')) {
+#else
+    if (path && strncmp(path, root, length) == 0 && path[length] == '/') {
+#endif
+        relative = path + length + 1;
+    }
+    const char *missing_trait = nullptr;
+    bool known = false;
+    if (relative) {
+        for (const auto &entry : typephp_declaration_files) {
+#ifdef PHP_WIN32
+            std::string normalized(relative);
+            std::replace(normalized.begin(), normalized.end(), '\\\\', '/');
+            const bool matches = _stricmp(normalized.c_str(), entry.path) == 0;
+#else
+            const bool matches = strcmp(relative, entry.path) == 0;
+#endif
+            if (matches) {
+                known = true;
+                missing_trait = entry.trait;
+                break;
+            }
+        }
+    }
+    if (resolved) {
+        zend_string_release(resolved);
+    }
+    if (known && *missing_trait) {
+        zend_error_noreturn(E_ERROR, "Trait \\"%s\\" not found", missing_trait);
+    }
+    return typephp_previous_compile_file(file, type);
+}
+
+ZEND_BEGIN_ARG_INFO_EX(arginfo_{$loader}, 0, 0, 1)
+    ZEND_ARG_TYPE_INFO(0, class, IS_STRING, 0)
+ZEND_END_ARG_INFO()
+PHP_FUNCTION({$loader}) {
+    zend_string *name;
+    ZEND_PARSE_PARAMETERS_START(1, 1)
+        Z_PARAM_STR(name)
+    ZEND_PARSE_PARAMETERS_END();
+    for (const auto &entry : typephp_unavailable_classes) {
+        if (ZSTR_LEN(name) == strlen(entry.name) && memcmp(ZSTR_VAL(name), entry.name, ZSTR_LEN(name)) == 0) {
+            zend_error_noreturn(E_ERROR, "Trait \\"%s\\" not found", entry.trait);
+        }
+    }
+}
+
+static void typephp_unavailable_request_shutdown() {
+    typephp_declaration_request_active = false;
+    if (typephp_declaration_runtime_root) {
+        zend_string_release(typephp_declaration_runtime_root);
+        typephp_declaration_runtime_root = nullptr;
+    }
+}
+
+static zend_result typephp_unavailable_request_init() {
+    if (typephp_declaration_runtime_root || typephp_declaration_request_active) {
+        return FAILURE;
+    }
+    char root[MAXPATHLEN];
+    if (!VCWD_GETCWD(root, sizeof(root))) {
+        return FAILURE;
+    }
+    char canonical[MAXPATHLEN];
+    if (!VCWD_REALPATH(root, canonical)) {
+        return FAILURE;
+    }
