+void typephp_register_source_method(zend_class_entry *ce, const char *name, const char *file,
+    uint32_t start, uint32_t end, bool generator);
+bool typephp_get_source_method_location(zend_function *function, const char **filename, uint32_t *line);
+struct TypephpNativeClassLinkContext {
+    zend_class_entry *ce;
+    decltype(zend_error_cb) previous_callback;
+    TypephpNativeClassLinkContext *previous;
+};
+static thread_local TypephpNativeClassLinkContext *typephp_native_class_link_context = nullptr;
+static void typephp_native_class_link_error(int type, zend_string *filename, uint32_t line, zend_string *message)
+{
+    auto *context = typephp_native_class_link_context;
+    auto callback = context->previous_callback;
+    for (auto *parent = context->previous; callback == typephp_native_class_link_error && parent != nullptr; parent = parent->previous) {
+        callback = parent->previous_callback;
+    }
+    if (type == E_COMPILE_ERROR && line == 0) {
+        void *entry;
+        ZEND_HASH_FOREACH_PTR(&context->ce->function_table, entry) {
+            auto *function = static_cast<zend_function *>(entry);
+            if (function->type != ZEND_INTERNAL_FUNCTION || function->common.scope != context->ce) continue;
+            const char *source;
+            uint32_t source_line;
+            if (!typephp_get_source_method_location(function, &source, &source_line)) continue;
+            std::string declaration;
+            if (function->common.fn_flags & ZEND_ACC_RETURN_REFERENCE) declaration = "& ";
+            if (function->common.scope->ce_flags & ZEND_ACC_ANON_CLASS) {
+                declaration += ZSTR_VAL(function->common.scope->name);
+            } else {
+                declaration.append(ZSTR_VAL(function->common.scope->name), ZSTR_LEN(function->common.scope->name));
+            }
+            declaration += "::";
+            declaration.append(ZSTR_VAL(function->common.function_name), ZSTR_LEN(function->common.function_name));
+            declaration += "(";
+            std::string prefix = "Declaration of " + declaration;
+            std::string unresolved = "Could not check compatibility between " + declaration;
+            const bool matched = (ZSTR_LEN(message) >= prefix.size()
+                    && memcmp(ZSTR_VAL(message), prefix.data(), prefix.size()) == 0)
+                || (ZSTR_LEN(message) >= unresolved.size()
+                    && memcmp(ZSTR_VAL(message), unresolved.data(), unresolved.size()) == 0);
+            if (matched) {
+                zend_string *source_file = zend_string_init(source, strlen(source), false);
+                callback(type, source_file, source_line, message);
+                zend_string_release(source_file);
+                return;
+            }
+        } ZEND_HASH_FOREACH_END();
+    }
+    callback(type, filename, line, message);
+}
+
+static zend_class_entry *typephp_link_user_class(zend_class_entry *ce)
+{
+    zend_string *key = zend_string_tolower(ce->name);
+    zend_string *parent_key = ce->parent_name ? zend_string_tolower(ce->parent_name) : nullptr;
+    if (zend_hash_add_ptr(EG(class_table), key, ce) == nullptr) {
+        zend_error(E_ERROR, "Cannot declare class %s, because the name is already in use", ZSTR_VAL(ce->name));
+        return nullptr;
+    }
+    TypephpNativeClassLinkContext context{ce, zend_error_cb, typephp_native_class_link_context};
+    typephp_native_class_link_context = &context;
+    zend_error_cb = typephp_native_class_link_error;
+    zend_class_entry *volatile linked = nullptr;
+    volatile bool bailed = false;
+    JMP_BUF *previous_bailout = EG(bailout);
+    try {
+        zend_try {
+            linked = zend_do_link_class(ce, parent_key, key);
+        } zend_catch {
+            bailed = true;
+        } zend_end_try();
+    } catch (...) {
+        EG(bailout) = previous_bailout;
+        zend_error_cb = context.previous_callback;
+        typephp_native_class_link_context = context.previous;
+        if (parent_key) zend_string_release(parent_key);
+        zend_string_release(key);
+        throw;
+    }
+    zend_error_cb = context.previous_callback;
+    typephp_native_class_link_context = context.previous;
+    if (bailed) {
+        if (parent_key) zend_string_release(parent_key);
+        zend_string_release(key);
+        zend_bailout();
+    }
+    if (linked == nullptr) {
+        // The request table owns the CE after insertion, including failed links.
+        zend_hash_del(EG(class_table), key);
+    } else {
+        typephp_check_native_overrides(linked);
+    }
+    if (parent_key) { zend_string_release(parent_key); }
+    zend_string_release(key);
+    php::throwErrorIfOccurred();
+    return linked;
+}
+
+static void typephp_init_user_enum(zend_class_entry *ce, uint8_t backing_type)
+{
+    ce->enum_backing_type = backing_type;
+    zend_enum_add_interfaces(ce);
+    zend_enum_register_props(ce);
+}
+
+static void typephp_declare_user_enum_case(zend_class_entry *ce, const char *name, zval *value)
+{
+    zend_string *case_name = zend_string_init(name, strlen(name), false);
+    zend_ast_zval class_node{}, case_node{}, value_node{};
