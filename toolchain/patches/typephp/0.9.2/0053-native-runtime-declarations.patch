+/** Successful output writes, separate from persistent compiler inputs and logs. */
+final class GeneratedArtifactReceipt
+{
+    public const array ROLES = [
+        'cpp-source', 'assembly-source', 'declaration-header', 'declaration-stub',
+        'generation-manifest', 'ast-cache', 'prepared-cache', 'stable-id-cache',
+        'incremental-state', 'object', 'object-cache', 'pch-header', 'pch',
