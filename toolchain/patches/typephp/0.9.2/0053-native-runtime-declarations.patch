+static void typephp_set_class_names(zend_class_name **names, uint32_t *count,
+    const char *const *values, uint32_t length)
+{
+    if (length == 0) { return; }
+    *names = static_cast<zend_class_name *>(emalloc(sizeof(zend_class_name) * length));
+    *count = length;
+    for (uint32_t index = 0; index < length; index++) {
+        (*names)[index].name = zend_string_init(values[index], strlen(values[index]), false);
+        (*names)[index].lc_name = zend_string_tolower((*names)[index].name);
+    }
+}
