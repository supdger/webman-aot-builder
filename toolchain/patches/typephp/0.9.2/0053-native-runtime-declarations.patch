+    return typephp_verify_scalar_type(mask, value, strict);
+}
+void typephp_throw_closure_return_error(zval *value, const char *callable, const char *expected) {
+    ZVAL_DEREF(value);
+    zend_type_error("%s(): Return value must be of type %s, %s returned",
+        callable, expected, zend_zval_value_name(value));
+    php::throwErrorIfOccurred();
+}
+static void typephp_check_native_parameter(zend_function *function, uint32_t parameter, uint32_t number, zval *value) {
+    zend_type type = function->common.arg_info[parameter].type;
+    if (!ZEND_TYPE_IS_SET(type)) { return; }
+    zend_reference *reference = Z_ISREF_P(value) ? Z_REF_P(value) : nullptr;
+    if (reference) { value = Z_REFVAL_P(value); }
+    if (ZEND_TYPE_CONTAINS_CODE(type, Z_TYPE_P(value))) { return; }
+    std::vector<void *> cache(typephp_parameter_cache_slots(type) + 1, nullptr);
+    if (!zend_check_user_type_slow(&type, value, reference, cache.data(), false)) {
+        if (!EG(exception)) {
+            zend_string *expected = zend_type_to_string_resolved(type, function->common.scope);
+            zend_execute_data *caller = EG(current_execute_data)->prev_execute_data;
+            if (caller && caller->func && ZEND_USER_CODE(caller->func->type) && caller->opline) {
+                zend_argument_type_error(number, "must be of type %s, %s given, called in %s on line %d",
+                    ZSTR_VAL(expected), zend_zval_value_name(value),
+                    ZSTR_VAL(caller->func->op_array.filename), caller->opline->lineno);
+            } else {
+                zend_argument_type_error(number, "must be of type %s, %s given",
+                    ZSTR_VAL(expected), zend_zval_value_name(value));
+            }
+            zend_string_release(expected);
+        }
+        php::throwErrorIfOccurred();
+    }
+}
+void typephp_check_native_parameters(zend_execute_data *frame) {
+    zend_function *function = frame->func;
+    for (uint32_t index = 0; index < ZEND_CALL_NUM_ARGS(frame); index++) {
+        uint32_t parameter = index;
+        if (parameter >= function->common.num_args) {
+            if (!(function->common.fn_flags & ZEND_ACC_VARIADIC)) { break; }
+            parameter = function->common.num_args;
+        }
+        typephp_check_native_parameter(function, parameter, index + 1, ZEND_CALL_ARG(frame, index + 1));
+    }
+    if ((function->common.fn_flags & ZEND_ACC_VARIADIC)
+        && (ZEND_CALL_INFO(frame) & ZEND_CALL_HAS_EXTRA_NAMED_PARAMS)) {
+        zval *value;
+        ZEND_HASH_FOREACH_VAL(frame->extra_named_params, value) {
+            typephp_check_native_parameter(function, function->common.num_args,
+                function->common.num_args + 1, value);
+        } ZEND_HASH_FOREACH_END();
+    }
+}
+php::Var typephp_call_scope_builtin(zend_function *function, const php::Array &scope, const php::Array &arguments) {
+    zend_execute_data *previous = EG(current_execute_data);
+    ZEND_ASSERT(previous && previous->func && ZEND_USER_CODE(previous->func->type));
+    zend_array *previous_symbols = previous->symbol_table;
+    bool had_symbols = (ZEND_CALL_INFO(previous) & ZEND_CALL_HAS_SYMBOL_TABLE) != 0;
+    previous->symbol_table = scope.array();
+    ZEND_ADD_CALL_FLAG(previous, ZEND_CALL_HAS_SYMBOL_TABLE);
+    php::Var result;
+    auto *frame = zend_vm_stack_push_call_frame(ZEND_CALL_NESTED_FUNCTION, function, 0, nullptr);
+    frame->prev_execute_data = previous;
+    frame->opline = nullptr;
+    frame->call = nullptr;
+    frame->return_value = result.ptr();
+    frame->symbol_table = nullptr;
+    frame->run_time_cache = nullptr;
+    frame->extra_named_params = nullptr;
+    uint32_t number = 1;
+    bool named = false;
+    zend_string *name;
+    zval *argument;
+    ZEND_HASH_FOREACH_STR_KEY_VAL(arguments.array(), name, argument) {
+        zval *target;
+        if (name) {
+            void *cache[2] = {nullptr, nullptr};
+            named = true;
+            target = zend_handle_named_arg(&frame, name, &number, cache);
+            if (target == nullptr) { break; }
+        } else {
+            if (named) {
+                zend_throw_error(nullptr, "Cannot use positional argument after named argument");
+                break;
+            }
+            zend_vm_stack_extend_call_frame(&frame, number - 1, 1);
+            target = ZEND_CALL_ARG(frame, number);
+            ZEND_CALL_NUM_ARGS(frame)++;
+        }
+        ZVAL_DEINDIRECT(argument);
+        if (!ARG_SHOULD_BE_SENT_BY_REF(function, number) && Z_ISREF_P(argument)) {
+            argument = Z_REFVAL_P(argument);
+        }
+        ZVAL_COPY(target, argument);
+        number++;
+    } ZEND_HASH_FOREACH_END();
+    if (!EG(exception) && (!(ZEND_CALL_INFO(frame) & ZEND_CALL_MAY_HAVE_UNDEF)
+        || zend_handle_undef_args(frame) == SUCCESS)) {
+        EG(current_execute_data) = frame;
+        ZEND_OBSERVER_FCALL_BEGIN(frame);
+        if (zend_execute_internal) { zend_execute_internal(frame, result.ptr()); }
+        else { function->internal_function.handler(frame, result.ptr()); }
+        ZEND_OBSERVER_FCALL_END(frame, result.ptr());
+        EG(current_execute_data) = previous;
+    }
+    zend_vm_stack_free_args(frame);
+    if (ZEND_CALL_INFO(frame) & ZEND_CALL_HAS_EXTRA_NAMED_PARAMS) {
+        zend_free_extra_named_params(frame->extra_named_params);
+    }
+    zend_vm_stack_free_call_frame(frame);
+    previous->symbol_table = previous_symbols;
+    if (!had_symbols) { ZEND_DEL_CALL_FLAG(previous, ZEND_CALL_HAS_SYMBOL_TABLE); }
+    if (EG(exception)) { zend_rethrow_exception(previous); }
+    php::throwErrorIfOccurred();
+    return result;
+}
+// This path executes only an explicit source eval() operand, never a
+// compiled file or function body. Its symbol table is the caller's table.
+php::Var typephp_eval_native(const php::Var &input, const php::Array &scope, const char *source, uint32_t line) {
+    php::Str script = input.toString();
+    std::string description = std::string(source) + "(" + std::to_string(line) + ") : eval()'d code";
+    uint32_t options = CG(compiler_options);
+    CG(compiler_options) = ZEND_COMPILE_DEFAULT_FOR_EVAL;
+    zend_op_array *program = zend_compile_string(script.str(), description.c_str(), ZEND_COMPILE_POSITION_AFTER_OPEN_TAG);
+    CG(compiler_options) = options;
+    if (program == nullptr) {
+        php::throwErrorIfOccurred();
+        return php::Var(false);
+    }
+    program->scope = zend_get_executed_scope();
+    struct LocalSymbols {
+        struct Binding { zend_string *name; zval *slot; };
+        const php::Array &scope;
+        std::vector<Binding> bindings;
+        explicit LocalSymbols(const php::Array &table) : scope(table) {
+            zend_string *name;
+            zval *value;
+            ZEND_HASH_FOREACH_STR_KEY_VAL(scope.array(), name, value) {
+                if (name == nullptr || Z_TYPE_P(value) != IS_INDIRECT) { continue; }
+                zval *slot = Z_INDIRECT_P(value);
+                bindings.push_back({zend_string_copy(name), slot});
+                ZVAL_COPY_VALUE(value, slot);
+                ZVAL_UNDEF(slot);
+            } ZEND_HASH_FOREACH_END();
+        }
+        void restore() {
+            for (const auto &binding : bindings) {
+                zval *value = zend_hash_find(scope.array(), binding.name);
+                if (value != nullptr) {
+                    ZVAL_DEINDIRECT(value);
+                    ZVAL_COPY_VALUE(binding.slot, value);
+                    ZVAL_UNDEF(value);
+                } else { ZVAL_UNDEF(binding.slot); }
+                zval indirect;
+                ZVAL_INDIRECT(&indirect, binding.slot);
+                zend_hash_update(scope.array(), binding.name, &indirect);
+                zend_string_release(binding.name);
+            }
+            std::vector<Binding>().swap(bindings);
+        }
+        ~LocalSymbols() { restore(); }
+    } symbols(scope);
+    php::Var result;
+    zend_try {
+        zend_execute_data *previous = EG(current_execute_data);
+        void *receiver = zend_get_this_object(previous);
+        uint32_t flags = ZEND_CALL_TOP_CODE | ZEND_CALL_HAS_SYMBOL_TABLE;
+        if (receiver != nullptr) { flags |= ZEND_CALL_HAS_THIS; }
+        else { receiver = zend_get_called_scope(previous); }
+        auto *frame = zend_vm_stack_push_call_frame(flags, reinterpret_cast<zend_function *>(program), 0, receiver);
+        frame->symbol_table = scope.array();
+        zend_init_code_execute_data(frame, program, result.ptr());
+        ZEND_OBSERVER_FCALL_BEGIN(frame);
+        zend_execute_ex(frame);
+        zend_vm_stack_free_call_frame(frame);
+    } zend_catch {
+        symbols.restore();
+        zend_destroy_static_vars(program);
+        destroy_op_array(program);
+        efree_size(program, sizeof(zend_op_array));
+        zend_bailout();
+    } zend_end_try();
+    symbols.restore();
+    zend_destroy_static_vars(program);
+    destroy_op_array(program);
+    efree_size(program, sizeof(zend_op_array));
+    php::throwErrorIfOccurred();
+    return result;
+}
+TypePhpNativeExecutionFrame::TypePhpNativeExecutionFrame(const char *source, const char *name, uint32_t line, zend_class_entry *scope, zend_object *object, zend_class_entry *called_scope, bool strict_types) {
+    auto *state = new TypePhpNativeExecutionState();
+    state_ = state;
+    state->function.type = ZEND_USER_FUNCTION;
+    state->function.scope = scope;
+    state->function.fn_flags = (scope && !object ? ZEND_ACC_STATIC : 0)
+        | (strict_types ? ZEND_ACC_STRICT_TYPES : 0);
+    state->function.filename = zend_string_init(source, strlen(source), false);
+    state->function.function_name = name[0] ? zend_string_init(name, strlen(name), false) : nullptr;
+    state->function.line_start = state->function.line_end = line;
+    state->function.last = 2;
+    state->function.opcodes = state->operations;
+    for (auto &operation : state->operations) {
+        operation.opcode = ZEND_NOP;
+        operation.lineno = line;
+        operation.op1_type = operation.op2_type = operation.result_type = IS_UNUSED;
+    }
+    ZVAL_UNDEF(&state->result);
+    state->previous = EG(current_execute_data);
+    state->previous_exception_line = EG(opline_before_exception);
+    state->frame = zend_vm_stack_push_call_frame(ZEND_CALL_NESTED_FUNCTION | (object ? ZEND_CALL_HAS_THIS : 0),
+        reinterpret_cast<zend_function *>(&state->function), 0,
+        object ? static_cast<void *>(object) : static_cast<void *>(scope ? (called_scope ? called_scope : scope) : nullptr));
+    state->frame->opline = state->operations;
+    state->frame->call = nullptr;
+    state->frame->return_value = &state->result;
+    state->frame->prev_execute_data = state->previous;
+    state->frame->symbol_table = nullptr;
+    state->frame->run_time_cache = nullptr;
+    state->frame->extra_named_params = nullptr;
+    typephp_native_execution_states.push_back(state);
+    EG(current_execute_data) = state->frame;
+}
+TypePhpNativeExecutionFrame::~TypePhpNativeExecutionFrame() {
+    auto *state = static_cast<TypePhpNativeExecutionState *>(state_);
+    EG(current_execute_data) = state->previous;
+    EG(opline_before_exception) = state->previous_exception_line;
+    if (EG(exception) && state->previous && state->previous->func
+        && ZEND_USER_CODE(state->previous->func->type)) {
+        zend_rethrow_exception(state->previous);
+    }
+    zend_vm_stack_free_call_frame(state->frame);
+    state->active = false;
+    auto position = std::find(typephp_native_execution_states.begin(), typephp_native_execution_states.end(), state);
+    if (position != typephp_native_execution_states.end()) typephp_native_execution_states.erase(position);
+    zend_string_release(state->function.filename);
+    if (state->function.function_name) zend_string_release(state->function.function_name);
+    delete state;
+}
+struct TypephpNativeOverrideSource {
+    const char *filename;
+    uint32_t line;
+};
+static thread_local std::unordered_map<const zend_attribute *, TypephpNativeOverrideSource>
+    typephp_native_override_sources;
+
+static void typephp_register_native_override(zend_class_entry *ce, const char *method,
+    const char *filename, uint32_t line)
+{
+    auto *function = static_cast<zend_function *>(
+        zend_hash_str_find_ptr(&ce->function_table, method, strlen(method)));
+    if (!function || function->type != ZEND_INTERNAL_FUNCTION) { return; }
+    zend_string *name = zend_string_init("Override", sizeof("Override") - 1, false);
+    zend_attribute *attribute = zend_add_function_attribute(function, name, 0);
+    zend_string_release(name);
+    attribute->lineno = line;
+    typephp_native_override_sources[attribute] = {filename, line};
+}
+
+static void typephp_check_native_overrides(zend_class_entry *ce)
+{
+    if (ce->ce_flags & ZEND_ACC_TRAIT) { return; }
+    void *entry;
+    zend_string *method;
+    ZEND_HASH_FOREACH_STR_KEY_PTR(&ce->function_table, method, entry) {
+        auto *function = static_cast<zend_function *>(entry);
+        if (!method || function->type != ZEND_INTERNAL_FUNCTION || function->common.scope != ce) { continue; }
+        zend_attribute *attribute = zend_get_attribute_str(function->common.attributes,
+            "override", sizeof("override") - 1);
+        auto source = typephp_native_override_sources.find(attribute);
+        if (source == typephp_native_override_sources.end()) { continue; }
+        bool matched = function->common.prototype != nullptr;
+        if (!matched && (ce->ce_flags & ZEND_ACC_INTERFACE)) {
+            for (uint32_t index = 0; index < ce->num_interfaces; index++) {
+                auto *parent = static_cast<zend_function *>(
+                    zend_hash_find_ptr(&ce->interfaces[index]->function_table, method));
+                if (parent && !(parent->common.fn_flags & ZEND_ACC_PRIVATE)) { matched = true; break; }
+            }
+        }
+        if (!matched) {
+            zend_string *filename = zend_string_init(source->second.filename,
+                strlen(source->second.filename), false);
+            zend_error_at_noreturn(E_COMPILE_ERROR, filename, source->second.line,
+                "%s::%s() has #[\\Override] attribute, but no matching parent method exists",
+                ZSTR_VAL(ce->name), ZSTR_VAL(function->common.function_name));
+        }
+    } ZEND_HASH_FOREACH_END();
+}
+
+void typephp_native_execution_shutdown() {
+    // Called after Zend deactivates its executor and closes suspended Fibers,
+    // before its request allocator is shut down. Bailout can skip destructors;
+    // their source metadata stays valid through executor teardown.
+    for (auto it = typephp_native_execution_states.rbegin(); it != typephp_native_execution_states.rend(); ++it) {
+        auto *state = *it;
+        zend_string_release(state->function.filename);
+        if (state->function.function_name) zend_string_release(state->function.function_name);
+        delete state;
+    }
+    typephp_native_execution_states.clear();
+    typephp_native_override_sources.clear();
+}
+php::Var typephp_parse_error(const char *message, const char *source, uint32_t line)
+{
+    zend_object *error = zend_throw_exception(zend_ce_parse_error, message, 0);
+    zend_update_property_string(zend_ce_error, error, ZEND_STRL("file"), source);
+    zend_update_property_long(zend_ce_error, error, ZEND_STRL("line"), line);
+    PHPX_THROW(error);
+    return php::Var();
+}
