+    /** Conservative definition proof only for new mixed PHP local joins. */
+    private function phpLocalWritesBeforeReads(NodeAbstract|array|null $body, string $name): bool
+    {
+        $valid = true;
+        $read = function (mixed $value, bool $written) use (&$read, &$valid, $name): void {
+            foreach (is_array($value) ? $value : [$value] as $node) {
+                if (!$node instanceof \PhpParser\Node) { continue; }
+                if ($node instanceof Variable && $node->name === $name && !$written) { $valid = false; }
+                if ($node instanceof \PhpParser\Node\Stmt\Goto_ || $node instanceof \PhpParser\Node\Stmt\Label) { $valid = false; }
+                if ($node instanceof \PhpParser\Node\Expr\Closure) {
+                    $read($node->uses, $written);
+                    continue;
+                }
+                if ($node instanceof \PhpParser\Node\FunctionLike && !$node instanceof \PhpParser\Node\Expr\ArrowFunction) { continue; }
+                foreach ($node->getSubNodeNames() as $field) { $read($node->{$field}, $written); }
+            }
+        };
+        $walk = function (mixed $value, bool $written) use (&$walk, &$valid, $read, $name): bool {
+            foreach (is_array($value) ? $value : [$value] as $node) {
+                if (!$node instanceof \PhpParser\Node) { continue; }
+                if ($node instanceof \PhpParser\Node\Stmt\Goto_ || $node instanceof \PhpParser\Node\Stmt\Label) {
+                    $valid = false;
+                } elseif ($node instanceof \PhpParser\Node\Stmt\Expression) {
+                    $written = $walk($node->expr, $written);
+                } elseif ($node instanceof \PhpParser\Node\Expr\Assign && $node->var instanceof Variable && $node->var->name === $name) {
+                    $read($node->expr, $written);
+                    $written = true;
+                } elseif ($node instanceof \PhpParser\Node\Stmt\If_) {
+                    $read($node->cond, $written);
+                    $branches = [$walk($node->stmts, $written)];
+                    foreach ($node->elseifs as $branch) {
+                        $read($branch->cond, $written);
+                        $branches[] = $walk($branch->stmts, $written);
+                    }
+                    $branches[] = $node->else === null ? $written : $walk($node->else->stmts, $written);
+                    $written = !in_array(false, $branches, true);
+                } else {
+                    // Other control flow supplies no new definition evidence.
+                    $read($node, $written);
+                }
+            }
+            return $written;
+        };
+        $walk($body, false);
+        return $valid;
