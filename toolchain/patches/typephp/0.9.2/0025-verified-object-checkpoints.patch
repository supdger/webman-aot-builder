+        // and header content identity. Unknown or external PCH options remain.
+        $pch = $values['precompiled_header'] ?? null;
+        $cache = str_replace('\\', '/', $this->getBuildDir()) . '/cache/pch';
+        if (is_array($pch) && is_string($pch['header'] ?? null) && is_string($pch['artifact'] ?? null)) {
+            $header = str_replace('\\', '/', $pch['header']);
+            $artifact = str_replace('\\', '/', $pch['artifact']);
+            if (preg_match('~^' . preg_quote($cache, '~') . '/[a-f0-9]{24}/typephp_pch\.hpp$~D', $header) === 1
+                && $artifact === dirname($header) . '/typephp_pch.pch') {
+                $digest = hash_file('sha256', $pch['header']);
+                if (!is_string($digest)) { throw new \RuntimeException('Cannot hash generated PCH input'); }
