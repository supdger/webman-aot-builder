{
  "name": "supdger/webman-aot-builder",
  "description": "Composer entry point for Webman AOT Builder; platform runtime is prepared separately",
  "type": "composer-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.0",
    "composer-plugin-api": "*",
    "composer": "*"
  },
  "extra": {
    "class": "Supdger\\WebmanAotInstaller\\Plugin",
    "plugin-optional": true
  },
  "bin": [
    "packages/composer-installer/bin/webman-aot"
  ],
  "autoload": {
    "psr-4": {
      "Supdger\\WebmanAotInstaller\\": "packages/composer-installer/src/"
    }
  },
  "archive": {
    "exclude": [
      "/.git",
      "/.gitattributes",
      "/.github/",
      "/.gitignore",
      "/CLAUDE.md",
      "/assets/",
      "/bin/",
      "/build.cmd",
      "/build.command",
      "/compatibility/",
      "/docs/",
      "/installer/",
      "/openspec/",
      "/scripts/",
      "/src/",
      "/tests/",
      "/toolchain/",
      "/toolchain.lock.json",
      "/tools/",
      "/dist/",
      "/packages/composer-installer/tests/"
    ]
  },
  "homepage": "https://github.com/supdger/webman-aot-builder",
  "support": {
    "issues": "https://github.com/supdger/webman-aot-builder/issues",
    "docs": "https://github.com/supdger/webman-aot-builder/wiki/Install"
  }
}
